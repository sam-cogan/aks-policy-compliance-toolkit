{
  "properties": {
    "displayName": "Kubernetes NetworkPolicies should not allow traffic from or to any peer",
    "policyType": "Custom",
    "mode": "Microsoft.Kubernetes.Data",
    "description": "Denies NetworkPolicy rules that match all sources or destinations (no from/to list, empty namespaceSelector without podSelector, or 0.0.0.0/0 / ::/0). Open egress restricted to listed ports can be allowed.",
    "metadata": {
      "category": "Kubernetes",
      "version": "1.0.0"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit",
        "metadata": {
          "displayName": "Effect"
        }
      },
      "excludedNamespaces": {
        "type": "Array",
        "defaultValue": [
          "kube-system",
          "gatekeeper-system",
          "azure-arc",
          "azure-extensions-usage-system"
        ],
        "metadata": {
          "displayName": "Namespace exclusions"
        }
      },
      "namespaces": {
        "type": "Array",
        "defaultValue": [],
        "metadata": {
          "displayName": "Namespace inclusions"
        }
      },
      "labelSelector": {
        "type": "Object",
        "defaultValue": {},
        "metadata": {
          "displayName": "Kubernetes label selector"
        }
      },
      "warn": {
        "type": "Boolean",
        "defaultValue": false,
        "metadata": {
          "displayName": "Warn"
        }
      },
      "allowPortScopedOpenEgress": {
        "type": "Boolean",
        "defaultValue": true,
        "metadata": {
          "displayName": "Allow open egress restricted to listed ports"
        }
      },
      "allowedOpenEgressPorts": {
        "type": "Array",
        "defaultValue": [
          53
        ],
        "metadata": {
          "displayName": "Ports allowed for open egress"
        }
      }
    },
    "policyRule": {
      "if": {
        "field": "type",
        "in": [
          "Microsoft.ContainerService/managedClusters",
          "Microsoft.Kubernetes/connectedClusters"
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "templateInfo": {
            "sourceType": "Base64Encoded",
            "content": ""
          },
          "apiGroups": [
            "networking.k8s.io"
          ],
          "kinds": [
            "NetworkPolicy"
          ],
          "excludedNamespaces": "[parameters('excludedNamespaces')]",
          "namespaces": "[parameters('namespaces')]",
          "labelSelector": "[parameters('labelSelector')]",
          "warn": "[parameters('warn')]",
          "values": {
            "allowPortScopedOpenEgress": "[parameters('allowPortScopedOpenEgress')]",
            "allowedOpenEgressPorts": "[parameters('allowedOpenEgressPorts')]"
          }
        }
      }
    }
  }
}